### TrendBite API 테스트 모음
### IntelliJ HTTP Client 전용. ▶ 버튼으로 개별 실행, 또는 Run All in File.
### 환경 변수: http-client.env.json (local / staging 스위치).


### ─────────────────────────────────────────────────────────────
### ① [Sanity] 시드 패턴 조회 — DB 만 사용, 외부 호출 0
### 부팅 후 가장 먼저 실행. 탕후루/흑당버블티/마라탕 3건 떠야 정상.
### ─────────────────────────────────────────────────────────────
GET {{baseUrl}}/api/v1/trend/patterns
Accept: application/json

> {%
client.test("3개 시드 패턴 적재됨", function () {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.length === 3, "패턴 3건이 아님: " + response.body.length);
});
%}


### ─────────────────────────────────────────────────────────────
### ② [캐시 MISS] 트렌드 분석 — 첫 호출 (FastAPI 거침, 느림)
### 응답 시간 기록 후 ③과 비교.
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/trend/analyze
Content-Type: application/json

{
  "keyword": "마라탕",
  "category": "dining"
}

> {%
client.global.set("missTime", response.headers.valueOf("X-Response-Time") || "n/a");
client.test("trend 분석 응답 OK", function () {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.trend_score !== undefined, "trend_score 필드 누락");
});
%}


### ─────────────────────────────────────────────────────────────
### ③ [캐시 HIT] 동일 요청 재호출 — 즉시 응답되어야 함
### TTL 6시간 안에는 ②와 같은 결과를 캐시에서 반환.
### DB 체크: SELECT COUNT(*) FROM trend_analysis_cache; — 1행만 있어야 정상.
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/trend/analyze
Content-Type: application/json

{
  "keyword": "마라탕",
  "category": "dining"
}

> {%
client.test("동일 응답 (캐시 hit)", function () {
    client.assert(response.status === 200);
    client.assert(response.body.trend_score !== undefined);
});
%}


### ─────────────────────────────────────────────────────────────
### ④ [Validation] category 누락 → 400 BAD_REQUEST
### @NotBlank 가 잡아내야 함.
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/trend/analyze
Content-Type: application/json

{
  "keyword": "탕후루"
}

> {%
client.test("400 반환", function () {
    client.assert(response.status === 400, "status 400 expected, got " + response.status);
});
%}


### ─────────────────────────────────────────────────────────────
### ⑤ 다른 키워드로 카운트 누적 (popular 정렬용 데이터 만들기)
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/trend/analyze
Content-Type: application/json

{
  "keyword": "흑당버블티",
  "category": "cafe"
}

###
POST {{baseUrl}}/api/v1/trend/analyze
Content-Type: application/json

{
  "keyword": "탕후루",
  "category": "snack"
}


### ─────────────────────────────────────────────────────────────
### ⑥ 인기 키워드 Top 5
### search_count DESC. ② & ③ 으로 마라탕은 2가 되어 있어야 함.
### ─────────────────────────────────────────────────────────────
GET {{baseUrl}}/api/v1/trend/popular?limit=5
Accept: application/json

> {%
client.test("인기 키워드 응답 OK", function () {
    client.assert(response.status === 200);
    client.assert(Array.isArray(response.body), "List가 아님");
});
%}


### ─────────────────────────────────────────────────────────────
### ⑦ [통합] 메인 진입점 — 4단계 (Location → Finance → Trend → Report)
### 가장 무거운 호출. LLM 리포트 생성 포함되어 10~20초 소요 가능.
### finance 바디는 협업자 FinanceRequestDto 스펙에 맞춤.
### location 좌표는 강남구 역삼동 예시.
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/analysis/run
Content-Type: application/json

{
  "keyword": "마라탕",
  "category": "dining",
  "location": {
    "address": "서울특별시 강남구 역삼동",
    "lat": 37.4979,
    "lng": 127.0276
  },
  "finance": {
    "menuInfo": {
      "menuName": "마라탕",
      "category": "dining",
      "sellingPrice": 12000,
      "packagingCostPerUnit": 300
    },
    "directMaterialCost": {
      "ingredientCostPerUnit": 4000
    },
    "directLaborCost": {
      "bohTimeMinutes": 5.0,
      "fohTimeMinutes": 3.0,
      "employees": [
        {
          "name": "사장",
          "mode": "simple",
          "monthlyTotal": 2500000
        },
        {
          "name": "주방 알바",
          "mode": "detail",
          "hourlyWage": 10030,
          "weeklyHours": 30.0,
          "hasNightShift": false
        }
      ]
    },
    "variableOverheadCostPerUnit": 500,
    "fixedCost": {
      "monthlyRent": 1500000,
      "managementFee": 200000,
      "marketingCost": 100000,
      "miscCost": 100000
    },
    "salesAssumption": {
      "expectedDailySales": 80,
      "workingDaysPerWeek": 6,
      "trendDurationWeeks": 12,
      "dailyWorkHours": 10.0
    }
  }
}

> {%
client.test("4단계 응답 모두 채워짐", function () {
    client.assert(response.status === 200, "status 200");
    client.assert(response.body.data.location !== null, "location 누락");
    client.assert(response.body.data.finance  !== null, "finance 누락");
    client.assert(response.body.data.trend    !== null, "trend 누락");
    client.assert(response.body.data.report   !== null, "report 누락");
    client.assert(response.body.data.report.llm_report.length > 0, "LLM 리포트 비어있음");
});
%}


### ─────────────────────────────────────────────────────────────
### ⑧ [에러 케이스] FastAPI 다운 시 503 확인
### 사용 전: FastAPI 서버 끄기 → 이 요청 실행 → 503 + TREND_SERVICE_UNAVAILABLE
### 캐시에 데이터 있으면 hit 되어 200 나올 수 있음.
### 새 키워드로 시도하거나 trend_analysis_cache 비우고 실행.
### ─────────────────────────────────────────────────────────────
POST {{baseUrl}}/api/v1/trend/analyze
Content-Type: application/json

{
  "keyword": "신규키워드_캐시없음",
  "category": "test"
}
